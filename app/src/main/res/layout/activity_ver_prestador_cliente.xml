<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Cliente.VerPrestadorCliente">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"
        android:orientation="horizontal"
        android:id="@+id/guideline3"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBarraInferior"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/main">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.1" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.9" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="40dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerImagem"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:background="@color/cinzaDivisor"
                android:layout_marginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/guideline4"
                app:layout_constraintStart_toEndOf="@id/guideline1"
                app:layout_constraintEnd_toStartOf="@id/guideline2">

                <ImageView
                    android:id="@+id/imgFotoPagina"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtNenhumaImagem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nenhuma_imagem_selecionada"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sair"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                app:backgroundTint="@color/azul"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_seta_esquerda_branco"
                app:iconSize="30dp"
                app:iconTint="@color/saborBranco"
                app:iconPadding="0dp"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/guideline4"
                app:layout_constraintStart_toEndOf="@id/guideline1" />

            <TextView
                android:id="@+id/txtNomePrestador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_username"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/containerImagem" />

            <LinearLayout
                android:id="@+id/layoutAvaliacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/txtNomePrestador"
                app:layout_constraintStart_toEndOf="@id/guideline1"
                app:layout_constraintEnd_toStartOf="@id/guideline2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtNotaPrestador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nota_placeholder"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_estrela_cheia"
                        app:tint="@color/laranja"
                        android:contentDescription="@string/label_estrela" />

                    <TextView
                        android:id="@+id/txtTotalAvaliacoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_avaliacoes_placeholder"
                        android:textColor="@color/cinza"
                        android:textSize="12sp" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnFavorito"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_estrela_vazia"
                    app:tint="@color/laranja"
                    android:contentDescription="@string/label_favoritar"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtSobre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_sobre"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/layoutAvaliacao" />

            <TextView
                android:id="@+id/txtDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_nenhuma_descricao_informada"
                android:textColor="@color/cinza"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtSobre" />

            <TextView
                android:id="@+id/txtTelefone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_telefone"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtDesc" />

            <TextView
                android:id="@+id/txtDescTelefone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="@string/placeholder_telefone"
                android:textColor="@color/cinza"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtTelefone" />

            <TextView
                android:id="@+id/txtServicos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_servicos_oferecidos"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtDescTelefone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServicos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtServicos"
                tools:listitem="@layout/item_servico_tag" />

            <TextView
                android:id="@+id/txtLocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_local_atuacao"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/rvServicos" />

            <ImageView
                android:id="@+id/imgLocLaranja"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_localizacao_laranja"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtLocal" />

            <TextView
                android:id="@+id/txtCidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_local"
                android:textColor="@color/azul"
                app:layout_constraintBottom_toBottomOf="@id/imgLocLaranja"
                app:layout_constraintStart_toEndOf="@id/imgLocLaranja"
                app:layout_constraintTop_toTopOf="@id/imgLocLaranja" />

            <TextView
                android:id="@+id/txtTituloFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_fotos"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/imgLocLaranja" />


            <TextView
                android:id="@+id/txtSemFotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter"
                android:text="@string/sem_fotos_adicionadas"
                android:textColor="@color/cinza"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtTituloFotos" />

            <ImageView
                android:id="@+id/imgFoto1"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:background="@color/cinzaClaro"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/imgFoto2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtTituloFotos" />

            <ImageView
                android:id="@+id/imgFoto2"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:background="@color/cinzaClaro"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgFoto1"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgFoto1"
                app:layout_constraintTop_toTopOf="@id/imgFoto1" />

            <ImageView
                android:id="@+id/imgFoto3"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:background="@color/cinzaClaro"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/imgFoto4"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/imgFoto1" />

            <ImageView
                android:id="@+id/imgFoto4"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_margin="5dp"
                android:background="@color/cinzaClaro"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/imgFoto3"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgFoto3"
                app:layout_constraintTop_toTopOf="@id/imgFoto3" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierFotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgFoto1,imgFoto2,imgFoto3,imgFoto4,txtSemFotos" />


            <TextView
                android:id="@+id/txtTituloAvaliacoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/label_avaliacoes"
                android:textColor="@color/azul"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/barrierFotos" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAvaliacoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toStartOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAvaliacoes"
                tools:listitem="@layout/item_avaliacao" />

            <TextView
                android:id="@+id/txtSemAvaliacoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter"
                android:text="@string/label_nenhuma_avaliacao_recebida"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintEnd_toStartOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtTituloAvaliacoes" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierAvaliacoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="rvAvaliacoes,txtSemAvaliacoes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAvaliar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:backgroundTint="@color/saborBranco"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_deixar_avaliacao"
                android:textColor="@color/azul"
                android:fontFamily="@font/inter"
                android:textSize="16sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/azul"
                app:strokeWidth="2dp"
                app:layout_constraintEnd_toStartOf="@+id/guideline2"
                app:layout_constraintStart_toStartOf="@+id/guideline1"
                app:layout_constraintTop_toBottomOf="@+id/barrierAvaliacoes" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>

    <include
        android:id="@+id/layoutBarraInferior"
        layout="@layout/barra_inferior_cliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>