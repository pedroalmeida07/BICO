<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaginaLogin"
    android:background="@color/saborBranco">

    <!--Linhas de Guia-->
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1"
        android:orientation="vertical"
        android:id="@+id/guideline1"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"
        android:orientation="vertical"
        android:id="@+id/guideline2"/>

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"
        android:orientation="horizontal"
        android:id="@+id/guideline3"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="73dp" />

<!--sim-->
    <View
        android:id="@+id/circuloCheio"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="-30dp"
        android:background="@drawable/circulo_cheio"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/circuloVazio"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/circulo_vazio"
        android:layout_marginTop="-140dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/quadradoVazio1"
        android:layout_width="300dp"
        android:layout_height="480dp"
        android:background="@drawable/quadrado_vazio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="-230dp"
        android:layout_marginBottom="-70dp"/>

    <View
        android:id="@+id/quadradoVazio2"
        android:layout_width="280dp"
        android:layout_height="480dp"
        android:rotation="45"
        android:background="@drawable/quadrado_vazio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginLeft="-230dp"
        android:layout_marginBottom="-60dp"/>

    <TextView
        android:id="@+id/txtEntrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entrar"
        android:textSize="30sp"
        android:textColor="@color/azul"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/guideline4"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/roboto_bold"
        />

    <TextView
        android:id="@+id/txtBoasVindas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bem-vindo de volta!"
        android:textSize="20sp"
        android:textColor="@color/cinza"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/txtEntrar"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/roboto_medium"
        />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:inputType="textEmailAddress"
        android:hint="Email"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:textColor="@color/cinza"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/txtBoasVindas"
        android:layout_marginTop="100dp"
        />

    <EditText
        android:id="@+id/edtSenha"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:inputType="textPassword"
        android:hint="Senha"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        android:textColor="@color/cinza"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/edtEmail"
        android:layout_marginTop="50dp"
        />

    <TextView
        android:id="@+id/txtEsqueceuSenha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/edtSenha"
        android:text="Esqueceu sua senha?"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/azul"
        android:gravity="end"
        android:layout_marginTop="30dp"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntrar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/txtEsqueceuSenha"
        android:text="Entrar"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/saborBranco"
        android:backgroundTint="@color/azul"
        android:layout_marginTop="30dp"
        app:cornerRadius="12dp"
        android:padding="12dp"
    />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCriarConta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/guideline1"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/btnEntrar"
        android:text="Criar Conta"
        android:fontFamily="@font/inter"
        android:textStyle="bold"
        android:textSize="17sp"
        android:textColor="@color/azul"
        android:backgroundTint="@color/saborBranco"
        android:layout_marginTop="30dp"
        app:cornerRadius="12dp"
        android:padding="12dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>