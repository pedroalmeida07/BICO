<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Prestador.PlanosPrestador">

    <!--Barra Superior-->
    <View
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/barra_superior_azul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sair"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:background="@drawable/ic_arrow_back_24"
        app:backgroundTint="@color/saborBranco"
        app:layout_constraintBottom_toBottomOf="@id/barraSuperior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/barraSuperior" />

    <TextView
        android:id="@+id/txtImpulso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Impulsionar Perfil"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="@id/barraSuperior"
        app:layout_constraintStart_toEndOf="@id/sair"
        app:layout_constraintTop_toTopOf="@id/barraSuperior" />

    <!-- Conteúdo Rolável -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/containerBarra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.1" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.9" />

            <TextView
                android:id="@+id/txtPlanoOuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Plano Ouro"
                android:textColor="@color/azul"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgPlanoOuro"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/logo_bico_ouro"
                app:layout_constraintStart_toStartOf="@+id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoOuro" />

            <TextView
                android:id="@+id/txtPlanoOuro1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Selo Ouro"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoOuro2"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoOuro"
                app:layout_constraintTop_toTopOf="@id/imgPlanoOuro" />

            <TextView
                android:id="@+id/txtPlanoOuro2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Conta impulsionada por 7 dias"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoOuro3"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoOuro"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoOuro1" />

            <TextView
                android:id="@+id/txtPlanoOuro3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Conta no topo das pesquisas"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoValor"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoOuro"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoOuro2" />

            <TextView
                android:id="@+id/txtPlanoValor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Preço: R$ 9,90 / semana"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/imgPlanoOuro"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoOuro"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoOuro3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanoOuro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Escolher Plano Ouro"
                android:textColor="@color/saborBranco"
                android:textSize="18sp"
                app:backgroundTint="@color/laranja"
                app:cornerRadius="13dp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/imgPlanoOuro" />

            <View
                android:id="@+id/linha1"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="20dp"
                android:background="@color/cinzaClaro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPlanoOuro" />

            <TextView
                android:id="@+id/txtPlanoPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_medium"
                android:text="Plano Premium"
                android:textColor="@color/azul"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/linha1" />

            <ImageView
                android:id="@+id/imgPlanoPremium"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/logo_bico_diamante"
                app:layout_constraintStart_toStartOf="@+id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoPremium" />

            <TextView
                android:id="@+id/txtPlanoPremium1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Selo Diamante"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoPremium2"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoPremium"
                app:layout_constraintTop_toTopOf="@id/imgPlanoPremium" />

            <TextView
                android:id="@+id/txtPlanoPremium2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Conta impulsionada por 30 dias"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoPremium3"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoPremium"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoPremium1" />

            <TextView
                android:id="@+id/txtPlanoPremium3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="✓ Conta no topo das pesquisas"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/txtPlanoValorPremium"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoPremium"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoPremium2" />

            <TextView
                android:id="@+id/txtPlanoValorPremium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Preço: R$ 29,90 / mês"
                android:textColor="@color/azul"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="@id/imgPlanoPremium"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toEndOf="@id/imgPlanoPremium"
                app:layout_constraintTop_toBottomOf="@id/txtPlanoPremium3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlanoPremium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Escolher Plano Premium"
                android:textColor="@color/saborBranco"
                android:textSize="18sp"
                app:backgroundTint="@color/azul"
                app:cornerRadius="13dp"
                app:layout_constraintEnd_toEndOf="@id/guideline2"
                app:layout_constraintStart_toStartOf="@id/guideline1"
                app:layout_constraintTop_toBottomOf="@id/imgPlanoPremium" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Barra Inferior Fixa -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerBarra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/barraInferior"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/barra_inferior_branca"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ic_home"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_home"
            app:layout_constraintBottom_toBottomOf="@id/barraInferior"
            app:layout_constraintEnd_toStartOf="@id/ic_chat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/barraInferior"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/ic_chat"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_chat"
            app:layout_constraintBottom_toBottomOf="@id/barraInferior"
            app:layout_constraintEnd_toStartOf="@id/ic_config"
            app:layout_constraintStart_toEndOf="@id/ic_home"
            app:layout_constraintTop_toTopOf="@id/barraInferior"
            app:tint="@color/black" />

        <ImageView
            android:id="@+id/ic_config"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/ic_config"
            app:layout_constraintBottom_toBottomOf="@id/barraInferior"
            app:layout_constraintEnd_toStartOf="@id/ic_user_barra"
            app:layout_constraintStart_toEndOf="@id/ic_chat"
            app:layout_constraintTop_toTopOf="@id/barraInferior"
            app:tint="@color/laranja" />

        <ImageView
            android:id="@+id/ic_user_barra"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/user"
            app:layout_constraintBottom_toBottomOf="@id/barraInferior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ic_config"
            app:layout_constraintTop_toTopOf="@id/barraInferior"
            app:tint="@color/black" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>