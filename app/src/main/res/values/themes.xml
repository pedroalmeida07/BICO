<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <!-- Desativar modo escuro automatico com Light ao inves de DayNight -->
    <style name="Base.Theme.Bico" parent="Theme.Material3.Light.NoActionBar">

        <!-- Cor da barra de status e dos icones dela -->
        <item name="android:statusBarColor">@color/saborBranco</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Cor da barra de navegação inferior (botões nativos) -->
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.Bico" parent="Base.Theme.Bico" />

    <!-- Theme for Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/corSplash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/corSplash</item>
        <item name="postSplashScreenTheme">@style/Theme.Bico</item>
        <item name="android:statusBarColor">@color/corSplash</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tema para botão arredondado (Floating Button) -->
    <style name="FAB_Arredondado">
        <item name="cornerSize">50dp</item>
    </style>
</resources>